# Brevo (https://www.brevo.com) — keep this secret
BREVO_API_KEY=xkeysib-xxxxxxxx

# Verified sender in Brevo
# Either plain email:
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Our Little Story
# Or combined:
# EMAIL_FROM="Our Little Story <you@yourdomain.com>"

# Default recipient emails (can also be managed in /admin)
YOUR_EMAIL=you@example.com
HER_EMAIL=her@example.com

# Password to access /admin
ADMIN_PASSWORD=change-me
